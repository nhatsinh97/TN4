SECRET_KEY=your-secret

# --- Cấu hình InfluxDB ---
# Với image all-in-one, InfluxDB chạy ngay trong container nên dùng localhost.
# Nếu kết nối tới hạ tầng bên ngoài, hãy đổi lại IP/hostname tương ứng.
INFLUXDB_HOST=localhost
INFLUXDB_PORT=8086
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=admin123
INFLUXDB_DATABASE=ats_data

# --- Cấu hình MQTT ---
MQTT_BROKER_ADDRESS=localhost
MQTT_PORT=1883
MQTT_TOPIC=PLC/LOGO/#
MQTT_BROKER_ADDRESS_ATS=localhost
MQTT_PORT_ATS=1883
MQTT_BROKER_ADDRESS_MQTT=localhost
MQTT_PORT_MQTT=1883
PLC_WATER_IP=10.16.40.160

# --- Endpoint API/Socket ---
# Đặt lại các URL này khi triển khai thực tế hoặc khi tách riêng dịch vụ.
SOCKET_SERVER_URL=http://localhost:58888
API_URL=
API_URL_CICO=

# TN4_BASE_DIR=/opt/tn4/src
# USER_FILE=./database/data_setup/users.json
TN4_BASE_DIR=/app/src
USER_FILE=/app/src/database/data_setup/users.json
