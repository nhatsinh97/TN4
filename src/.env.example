# Secret key for Flask sessions
SECRET_KEY=replace-me

# InfluxDB configuration (Docker defaults align with docker-compose.yml)
INFLUXDB_HOST=influxdb
INFLUXDB_PORT=8086
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=admin123
INFLUXDB_DATABASE=ats_data

# MQTT broker settings
MQTT_BROKER_ADDRESS=mqtt
MQTT_PORT=1883
MQTT_TOPIC=tn4/data
# Uncomment if your broker requires authentication
# MQTT_USERNAME=user
# MQTT_PASSWORD=pass

# ATS socket bridge configuration
MQTT_BROKER_ADDRESS_ATS=mqtt
MQTT_PORT_ATS=1883
